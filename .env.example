# Папка на хосте с репозиториями, в контейнерах это /repos. Обязательна: без неё compose не стартует.
# Можно указать любой путь на хосте. В примере — ./data/repos внутри проекта (в .gitignore).
# Создайте папку заранее (mkdir -p), иначе Docker создаст её от root и запись упадёт.
# Путь вне каталога проекта задавайте абсолютным: Compose не раскрывает "~".
HOST_REPOS_DIR=./data/repos

# Владелец репозиториев на хосте: id -u и id -g.
# Пользователь app в контейнерах создаётся с этими UID и GID. Нужны значения от 1000:
# меньшие заняты системными пользователями образов, root (0) не подходит.
# Если изменить их позже, пересоберите образы и пересоздайте том opencode-data
# (docker compose down -v удалит чаты).
HOST_UID=1000
HOST_GID=1000

# Пароль к opencode (Basic, пользователь opencode). Обязателен: без него compose не стартует.
# Если в пароле есть "$" или "#", возьмите значение в одинарные кавычки.
OPENCODE_SERVER_PASSWORD=
